# Runtime
NODE_ENV=development

# Host Port Bindings
API_PORT=5000
CLIENT_PORT=3000

# Database & Queue Connections (Docker internal hostnames)
MONGO_URI=mongodb://mongo:27017/mediavault
REDIS_URL=redis://redis:6379

# Authentication & Security
# REQUIRED: Generate a cryptographically secure random secret (>= 32 chars) before starting:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
ALLOW_REGISTRATION=true
COOKIE_SECURE=false

# Storage & Worker Configuration
# Host path mounted to container /data/downloads (e.g. C:/Users/<YourName>/Downloads/MediaVault)
HOST_DOWNLOADS_DIR=./data/downloads
DOWNLOADS_DIR=/data/downloads
COOKIES_DIR=/data/cookies
# 0 = keep files permanently in Downloads; set >0 (e.g. 30) to auto-purge after N minutes
DOWNLOAD_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5
WORKER_CONCURRENCY=2
MIN_FREE_DISK_BYTES=2147483648
# 0 = unlimited (full playlist inspection and full playlist batch queuing)
MAX_PLAYLIST_ITEMS=0
MAX_BATCH_ITEMS=0

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
INTERNAL_API_URL=http://api:5000

# Optional named Cloudflare Tunnel token (Quick Tunnels can also be started in the app)
CLOUDFLARE_TUNNEL_TOKEN=
